<div class="stt-welcome">
    <h3>{{heading}}</h3>

    {{#if intro}}<p>{{intro}}</p>{{/if}}

    {{#if places.length}}
    <ul class="stt-welcome-list">
        {{!-- Each place is already escaped, with the request button in it. --}}
        {{#each places}}<li>{{{this}}}</li>{{/each}}
    </ul>
    {{/if}}

    {{#if lines.length}}
    {{#if newTitle}}<h4>{{newTitle}}</h4>{{/if}}
    <ul class="stt-welcome-list">
        {{#each lines}}<li>{{this}}</li>{{/each}}
    </ul>
    {{/if}}

    <h4>{{settingsTitle}}</h4>
    <div class="stt-welcome-buttons">
        {{#each buttons}}
        <button type="button" data-stt-settings-menu="{{menu}}"><i class="{{icon}}" inert></i> {{label}}</button>
        {{/each}}
    </div>

    <p class="stt-welcome-foot"><a href="{{guide}}" target="_blank" rel="noopener">{{guideLabel}}</a></p>
</div>
