{{!-- The roll picker, for a roll and each of its alternatives. --}}
{{#*inline "sttRollSelect"}}
<select name="{{name}}" aria-label="{{label}}">
    {{#each @root.rollOptions as |group|}}
    <optgroup label="{{group.label}}">
        {{#each group.options as |option|}}
        <option value="{{option.value}}" {{#if (eq option.value ../../selected)}}selected{{/if}}>{{option.label}}</option>
        {{/each}}
    </optgroup>
    {{/each}}
</select>
{{/inline}}

{{#*inline "sttQuickPicks"}}
{{#if picks.length}}
<div class="stt-request-picks" role="group" aria-label="{{localize 'STT.Request.Config.Picks.Label'}}">
    {{#each picks as |pick|}}
    <button type="button" class="stt-request-pick" data-action="pickGroup" data-group="{{pick.id}}"
            {{#if pick.hasSide}}data-side="{{pick.side}}"{{/if}} aria-pressed="{{pick.pressed}}"
            data-tooltip-text="{{pick.tooltip}}">
        <i class="{{pick.icon}}" inert></i>
        <span class="stt-request-pick-label">{{pick.label}}</span>
        <span class="stt-request-pick-count">{{pick.count}}</span>
    </button>
    {{/each}}
</div>
{{/if}}
{{/inline}}

<div class="stt-request-form">

    {{!-- Mode --}}
    <fieldset class="stt-request-modes">
        <legend>{{localize "STT.Request.Config.KindOfRoll"}}</legend>
        {{#each modes as |mode|}}
        <label class="stt-request-mode">
            <input type="radio" name="mode" value="{{mode.value}}" {{checked mode.checked}}>
            <i class="{{mode.icon}}" inert></i>
            <span class="stt-request-mode-label">{{mode.label}}</span>
            <span class="stt-request-mode-hint">{{mode.hint}}</span>
        </label>
        {{/each}}
    </fieldset>

    {{!-- Rolls --}}
    <fieldset class="stt-request-parts">
        <legend>{{localize "STT.Request.Config.Rolls"}}</legend>
        {{#each rows as |row|}}
        <div class="form-group">
            <label>{{row.label}}</label>
            <div class="form-fields">
                {{> sttRollSelect name=(concat row.field ".roll") selected=row.roll label=row.label}}
                {{#if row.canChoose}}
                <button type="button" class="stt-request-choice-button" data-action="addChoice" data-field="{{row.field}}"
                        data-tooltip aria-label="{{localize 'STT.Request.Config.AddChoice'}}" {{disabled row.full}}>
                    <i class="fa-solid fa-plus" inert></i>
                </button>
                {{/if}}
                {{#if row.hasDC}}
                <label class="stt-request-dc">
                    {{localize "STT.Request.Config.DC"}} <input type="number" name="{{row.field}}.dc" value="{{row.dc}}" min="0" step="1" placeholder="—">
                </label>
                {{/if}}
            </div>
        </div>
        {{#each row.alternatives as |choice|}}
        <div class="form-group stt-request-choice">
            <label>{{localize "STT.Request.Config.Or"}}</label>
            <div class="form-fields">
                {{> sttRollSelect name=(concat row.field ".alternatives." choice.index ".roll") selected=choice.roll label=(localize "STT.Request.Config.Or")}}
                <button type="button" class="stt-request-choice-button" data-action="removeChoice"
                        data-field="{{row.field}}" data-index="{{choice.index}}"
                        data-tooltip aria-label="{{localize 'STT.Request.Config.RemoveChoice'}}">
                    <i class="fa-solid fa-xmark" inert></i>
                </button>
                {{#if row.choiceDCs}}
                <label class="stt-request-dc">
                    {{localize "STT.Request.Config.DC"}} <input type="number" name="{{row.field}}.alternatives.{{choice.index}}.dc" value="{{choice.dc}}" min="0" step="1" placeholder="—">
                </label>
                {{else}}
                <span class="stt-request-dc" aria-hidden="true"></span>
                {{/if}}
            </div>
        </div>
        {{/each}}
        {{/each}}
        {{#if challenge}}
        <div class="form-group">
            <label>{{localize "STT.Request.Config.SuccessesNeeded"}}</label>
            <div class="form-fields">
                <select name="successes">
                    {{#each successOptions as |option|}}
                    <option value="{{option.value}}" {{#if (eq option.value @root.successes)}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="hint">{{localize "STT.Request.Config.ChallengeHint"}}</p>
        </div>
        {{/if}}
        {{#if team}}
        <div class="form-group">
            <label>{{localize "STT.Request.Config.Scoring"}}</label>
            <div class="form-fields">
                <select name="scoring">
                    {{#each scoringOptions as |option|}}
                    <option value="{{option.value}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                </select>
            </div>
            <p class="hint stt-request-scoring-hint">{{scoringHint}}</p>
        </div>
        {{/if}}
        {{#if contest}}
        <p class="hint">{{localize "STT.Request.Config.ContestHint"}}</p>
        {{/if}}
        {{#if divine}}
        <div class="form-group">
            <label>{{localize "STT.Request.Config.NumbersToPick"}}</label>
            <div class="form-fields">
                <range-picker name="range" value="{{range}}" min="{{rangeLimits.min}}" max="{{rangeLimits.max}}" step="1"></range-picker>
            </div>
            <p class="hint">{{localize "STT.Request.Config.DivineHint"}}</p>
        </div>
        {{/if}}
    </fieldset>

    {{!-- Actors --}}
    {{#if contest}}
    <div class="stt-request-sides">
        {{#each sides as |side|}}
        {{#if side.side}}<div class="stt-request-versus" aria-hidden="true">{{localize "STT.Request.Versus"}}</div>{{/if}}
        <fieldset class="stt-request-side">
            <legend>
                {{side.label}}
                {{#unless side.single}}
                <button type="button" class="stt-request-select-all" data-action="selectAll"
                        data-tooltip aria-label="{{localize 'STT.Request.Config.SelectAll'}}">
                    <i class="fa-solid fa-check-double" inert></i>
                </button>
                {{/unless}}
            </legend>
            {{> sttQuickPicks picks=side.picks}}
            <div class="stt-request-actor-list">
                {{#each side.actors as |actor|}}
                <label class="stt-request-actor-choice">
                    {{#if side.single}}
                    <input type="radio" name="rivals.{{side.side}}" value="{{actor.index}}" {{checked actor.checked}}>
                    {{else}}
                    <input type="checkbox" name="teams.{{side.side}}.{{actor.index}}" {{checked actor.checked}}>
                    {{/if}}
                    <img src="{{actor.img}}" alt="">
                    <span>{{actor.name}}</span>
                </label>
                {{/each}}
            </div>
        </fieldset>
        {{/each}}
    </div>
    {{else}}
    <fieldset>
        <legend>
            {{localize "STT.Request.Config.WhoRolls"}}
            {{#unless divine}}
            <button type="button" class="stt-request-select-all" data-action="selectAll"
                    data-tooltip aria-label="{{localize 'STT.Request.Config.SelectAll'}}">
                <i class="fa-solid fa-check-double" inert></i>
            </button>
            {{/unless}}
        </legend>
        {{!-- Divine Intervention is one actor's prayer, so it picks one actor and has no quick picks. --}}
        {{#unless divine}}{{> sttQuickPicks picks=picks}}{{/unless}}
        <div class="stt-request-actor-list">
            {{#each actors as |actor|}}
            <label class="stt-request-actor-choice">
                {{#if @root.divine}}
                <input type="radio" name="actor" value="{{actor.index}}" {{checked actor.checked}}>
                {{else}}
                <input type="checkbox" name="actors.{{actor.index}}" {{checked actor.checked}}>
                {{/if}}
                <img src="{{actor.img}}" alt="">
                <span>{{actor.name}}</span>
            </label>
            {{else}}
            <p class="hint">{{localize "STT.Request.Config.NoActors"}}</p>
            {{/each}}
        </div>
    </fieldset>
    {{/if}}

    {{!-- Options --}}
    <fieldset>
        <legend>{{localize "STT.Request.Config.Options"}}</legend>
        {{#unless (or contest divine)}}
        <div class="form-group">
            <label>{{localize "STT.Request.Config.ShowDC"}}</label>
            <div class="form-fields">
                <input type="checkbox" name="showDC" {{checked showDC}}>
            </div>
            <p class="hint">{{localize "STT.Request.Config.ShowDCHint"}}</p>
        </div>
        {{/unless}}
        <div class="form-group">
            <label>{{localize "STT.Request.Config.Visibility"}}</label>
            <div class="form-fields">
                <select name="rollMode">
                    <option value="public" {{#if (eq rollMode "public")}}selected{{/if}}>{{localize "STT.Request.Config.Public"}}</option>
                    <option value="gm" {{#if (eq rollMode "gm")}}selected{{/if}}>{{localize "STT.Request.Config.Private"}}</option>
                </select>
            </div>
            <p class="hint">{{localize "STT.Request.Config.PrivateHint"}}</p>
        </div>
    </fieldset>

</div>
